OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_PROVIDER=hermes
# Hermes is opt-in because the existing bridge invokes an agent runtime that
# may have its own tools. Use a dedicated read-only Hermes profile in production.
HERMES_AI_ENABLED=false
HERMES_BRIDGE_URL=http://127.0.0.1:8787
HERMES_BRIDGE_TOKEN=
# Public contact URI used to sign Web Push requests. A public HTTPS app origin
# is recommended for Apple Push Service; avoid localhost and *.local values.
VAPID_SUBJECT=https://your-app.example.com

AI_EXECUTIVE_AUTH_ENABLED=true
AI_EXECUTIVE_PASSWORD_HASH=
AI_EXECUTIVE_SESSION_SECRET=
# Optional stable encryption secret for private ICS feed URLs. Use at least 32
# random characters. If omitted, the session secret is used; rotating it then
# requires reconnecting calendar feeds.
AI_EXECUTIVE_CALENDAR_SECRET=
AI_EXECUTIVE_AUDIT_KEY=
AI_EXECUTIVE_SECURITY_OUTBOX_DIR=/var/lib/ai-executive-security/outbox
# Optional comma-separated browser origins accepted for writes when a reverse proxy
# reconstructs a different request URL (for example https://host.example:8443).
AI_EXECUTIVE_ALLOWED_ORIGINS=
# Exact origins allowed to create and use passkeys. RP IDs are derived only from
# this administrator-controlled allowlist, never from request headers.
AI_EXECUTIVE_PASSKEY_ORIGINS=

# Dedicated bearer token for external Lumi clients such as a future ChatGPT connector.
# Generate at least 32 random characters. This is separate from browser sessions.
AI_EXECUTIVE_INTEGRATION_TOKEN=

# Default deny. Explicit workspace IDs for external context.search tool (comma separated).
# A bearer token alone or '*' never grants Context Graph access; leave empty until reviewed.
AI_EXECUTIVE_CONTEXT_SEARCH_WORKSPACES=
