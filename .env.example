OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Public contact URI used to sign Web Push requests. A public HTTPS app origin
# is recommended for Apple Push Service; avoid localhost and *.local values.
VAPID_SUBJECT=https://your-app.example.com

AI_EXECUTIVE_AUTH_ENABLED=true
AI_EXECUTIVE_PASSWORD_HASH=
AI_EXECUTIVE_SESSION_SECRET=
# Optional comma-separated browser origins accepted for writes when a reverse proxy
# reconstructs a different request URL (for example https://host.example:8443).
AI_EXECUTIVE_ALLOWED_ORIGINS=
# Exact origins allowed to create and use passkeys. RP IDs are derived only from
# this administrator-controlled allowlist, never from request headers.
AI_EXECUTIVE_PASSKEY_ORIGINS=
